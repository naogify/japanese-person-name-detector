{
  "name": "@naogify/japanese-person-name-detector",
  "version": "0.1.0",
  "description": "文字列が日本の個人の氏名に見えるかを判定する（姓名形の規則・姓名辞書・任意で Jev）",
  "keywords": [
    "japanese",
    "name",
    "personal-name",
    "person-name",
    "detector",
    "privacy",
    "pii",
    "氏名",
    "人名",
    "個人名"
  ],
  "homepage": "https://github.com/naogify/japanese-person-name-detector#readme",
  "bugs": {
    "url": "https://github.com/naogify/japanese-person-name-detector/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naogify/japanese-person-name-detector.git"
  },
  "author": "naogify",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "mutation": "npm run build && node scripts/mutation.mjs",
    "prepublishOnly": "npm test && node scripts/check-publish.mjs"
  },
  "dependencies": {
    "@naogify/japanese-person-name-dictionary": "github:naogify/japanese-person-name-dictionary#ca1d61ef5f7dd672d49eb7e3ccb804cd38b67b0d"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
