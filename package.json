{
  "name": "@naogify/japanese-person-name-detector",
  "version": "0.1.0",
  "description": "文字列が日本の個人の氏名（姓＋全角スペース＋名）に見えるかを判定する",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naogify/japanese-person-name-detector.git"
  },
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "mutation": "npm run build && node scripts/mutation.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
